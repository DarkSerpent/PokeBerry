    <div class="form-group">
      <label>{{localize "POKEBERRY.CurrentStage"}}</label>
      <div class="form-fields">
        <select name="flags.pokeberry.stage">
          {{#if berry.isApricorn}}
          <option value="planted" {{#if (eq berry.stage "planted")}}selected{{/if}}>{{localize "POKEBERRY.Planted"}}</option>
          <option value="sprouted" {{#if (eq berry.stage "sprouted")}}selected{{/if}}>{{localize "POKEBERRY.Sprouted"}}</option>
          <option value="growing" {{#if (eq berry.stage "growing")}}selected{{/if}}>{{localize "POKEBERRY.Growing"}}</option>
          <option value="ready" {{#if (eq berry.stage "ready")}}selected{{/if}}>{{localize "POKEBERRY.Ready"}}</option>
          {{else}}
          <option value="planted" {{#if (eq berry.stage "planted")}}selected{{/if}}>{{localize "POKEBERRY.Planted"}}</option>
          <option value="sprouted" {{#if (eq berry.stage "sprouted")}}selected{{/if}}>{{localize "POKEBERRY.Sprouted"}}</option>
          <option value="taller" {{#if (eq berry.stage "taller")}}selected{{/if}}>{{localize "POKEBERRY.Taller"}}</option>
          <option value="flowering" {{#if (eq berry.stage "flowering")}}selected{{/if}}>{{localize "POKEBERRY.Flowering"}}</option>
          <option value="ready" {{#if (eq berry.stage "ready")}}selected{{/if}}>{{localize "POKEBERRY.Ready"}}</option>
          {{/if}}
        </select>
      </div>
